# Cloudflare 정적 자산이 모든 응답에 붙여주는 헤더입니다.
# (_redirects 와 같은 방식으로 동작합니다)
#
# ⚠️ 이 파일만으로는 평문 HTTP 접속을 막지 못합니다.
#    HSTS 는 "다음부터는 HTTPS 로만 와라" 는 약속이라, 브라우저가 이 사이트에
#    한 번이라도 HTTPS 로 들어와 본 뒤에야 효과가 생깁니다. 처음 오는 사람이
#    http:// 로 들어오는 그 한 번은 여전히 평문입니다.
#    Cloudflare 대시보드 → SSL/TLS → Edge Certificates → Always Use HTTPS
#    를 켜야 그것까지 막힙니다. docs/STUDIO.md 참고.

/*
  # 한 번 HTTPS 로 온 브라우저는 1년간 http:// 를 스스로 https:// 로 바꿉니다.
  # includeSubDomains·preload 는 일부러 뺐습니다. 하위 도메인을 나중에
  # 만들었을 때 그쪽이 HTTPS 가 아니면 통째로 접속이 막히고, preload 는
  # 목록에서 빼는 데 몇 달이 걸립니다.
  Strict-Transport-Security: max-age=31536000

  # 선언한 Content-Type 을 브라우저가 멋대로 추측하지 않게 합니다.
  X-Content-Type-Options: nosniff

  # 다른 사이트가 우리 화면을 iframe 에 넣고 그 위에 투명한 버튼을 얹는
  # 방식(클릭재킹)을 막습니다. 로그인·브리딩 화면이 특히 대상입니다.
  X-Frame-Options: DENY

  # 외부 링크로 나갈 때 우리 쪽 전체 주소를 넘기지 않습니다.
  # 계산기 주소에는 개인정보가 없지만, 넘길 이유도 없습니다.
  Referrer-Policy: strict-origin-when-cross-origin

  # 쓰지 않는 기능은 아예 꺼 둡니다.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
