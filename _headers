# Cloudflare 정적 자산이 모든 응답에 붙여주는 헤더입니다.
# (_redirects 와 같은 방식으로 동작합니다)
#
# ⚠️ 이 파일만으로는 평문 HTTP 접속을 막지 못합니다.
#    HSTS 는 "다음부터는 HTTPS 로만 와라" 는 약속이라, 브라우저가 이 사이트에
#    한 번이라도 HTTPS 로 들어와 본 뒤에야 효과가 생깁니다. 처음 오는 사람이
#    http:// 로 들어오는 그 한 번은 여전히 평문입니다.
#    Cloudflare 대시보드 → SSL/TLS → Edge Certificates → Always Use HTTPS
#    를 켜야 그것까지 막힙니다. docs/STUDIO.md 참고.

/*
  # 한 번 HTTPS 로 온 브라우저는 1년간 http:// 를 스스로 https:// 로 바꿉니다.
  # includeSubDomains·preload 는 일부러 뺐습니다. 하위 도메인을 나중에
  # 만들었을 때 그쪽이 HTTPS 가 아니면 통째로 접속이 막히고, preload 는
  # 목록에서 빼는 데 몇 달이 걸립니다.
  Strict-Transport-Security: max-age=31536000

  # 선언한 Content-Type 을 브라우저가 멋대로 추측하지 않게 합니다.
  X-Content-Type-Options: nosniff

  # 다른 사이트가 우리 화면을 iframe 에 넣고 그 위에 투명한 버튼을 얹는
  # 방식(클릭재킹)을 막습니다. 로그인·브리딩 화면이 특히 대상입니다.
  X-Frame-Options: DENY

  # 외부 링크로 나갈 때 우리 쪽 전체 주소를 넘기지 않습니다.
  # 계산기 주소에는 개인정보가 없지만, 넘길 이유도 없습니다.
  Referrer-Policy: strict-origin-when-cross-origin

  # 쓰지 않는 기능은 아예 꺼 둡니다.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

  # 어디서 무엇을 불러올 수 있는지 못박습니다.
  #
  # ⚠️ 지금은 Report-Only 입니다. 위반해도 막지 않고 콘솔에만 알립니다.
  #    실제로 깨지는 곳이 없는지 확인한 뒤 Content-Security-Policy 로 이름을
  #    바꾸면 그때부터 차단됩니다. 이름만 바꾸면 됩니다.
  #
  # script-src 와 style-src 에 'unsafe-inline' 이 있는 이유 — 이 사이트는
  # onclick 같은 인라인 핸들러가 165곳, 인라인 <script> 가 21곳, style="" 이
  # 238곳입니다. nonce 나 해시로는 onclick 을 덮을 수 없어서, 그것들을 전부
  # 걷어내기 전에는 뺄 수 없습니다. 즉 이 정책은 XSS 자체를 막지는 못합니다.
  # 대신 값이 있는 쪽은 아래입니다.
  #   connect-src  : 스크립트가 실행되더라도 데이터를 남의 서버로 못 보냅니다
  #   object-src   : 플래시·플러그인 삽입을 막습니다
  #   base-uri     : <base> 를 심어 모든 상대경로를 가로채는 수법을 막습니다
  #   form-action  : 폼을 남의 서버로 제출하게 바꾸는 것을 막습니다
  #   frame-ancestors : X-Frame-Options 와 같은 뜻이되, 최신 브라우저 기준입니다
  #
  # 허용한 출처는 실제로 쓰는 것만 넣었습니다(라이브에서 확인).
  #   cdn.jsdelivr.net        : supabase-js, pretendard, bootstrap-icons(+폰트)
  #   static.cloudflareinsights.com : Cloudflare 가 자동으로 넣는 방문 통계
  #   icjuhsktqcfloiqdfxtm    : Supabase REST · 사진(서명 URL)
  #   challenges.cloudflare.com : Turnstile. 지금은 꺼져 있지만 켤 때 필요합니다
  #   blob: / data:           : 사진 자르기·카드 내보내기가 캔버스로 만듭니다
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https://icjuhsktqcfloiqdfxtm.supabase.co; connect-src 'self' https://icjuhsktqcfloiqdfxtm.supabase.co https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
