{
  // ryangstudio.com 은 Pages 가 아니라 '정적 자산만 있는 Worker' 로 돌아갑니다.
  // (그래서 wrangler pages 계열 명령에는 아무것도 잡히지 않습니다.)
  // 배포:  npx wrangler deploy
  "name": "ryangstudio",
  "compatibility_date": "2026-07-27",

  // 저장소 루트가 아니라 dist/ 를 올립니다. 루트에는 supabase_*.sql 과 docs/ 가
  // 같이 있어서 그대로 배포하면 공개됩니다. dist/ 는 ./build.sh 가 git 목록에서
  // 사이트 파일만 골라 만듭니다. 배포 전에 ./build.sh 를 먼저 실행하세요.
  // not_found_handling 은 두지 않습니다. single-page-application 으로 두면 없는
  // 주소가 전부 200 + 메인 페이지가 되어, 검색엔진이 존재하지 않는 URL 을 계속
  // 색인하고 깨진 링크도 드러나지 않습니다. 여러 페이지로 된 정적 사이트라
  // 없는 주소는 그냥 404 가 맞습니다. 옛 경로는 _redirects 가 처리합니다.
  "assets": {
    "directory": "./dist"
  },

  // 대시보드에서 이미 붙여둔 커스텀 도메인. 명시해 두지 않으면 배포하면서
  // 연결이 끊길 수 있어 그대로 적어둡니다. www 는 DNS 에 없어서 넣지 않습니다.
  "routes": [
    { "pattern": "ryangstudio.com", "custom_domain": true }
  ]
}
